{
  "expo": {
    "name": "Gym Log",
    "slug": "gym-log",
    "scheme": "gymlog",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/branding/icon.png",
    "backgroundColor": "#121214",
    "android": {
      "package": "com.gymlog.app",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/adaptive-monochrome.png",
          "color": "#10B981",
          "sounds": [
            "./assets/sounds/rest_finish.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Gym Log uses the camera to scan food barcodes and nutrition labels.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
