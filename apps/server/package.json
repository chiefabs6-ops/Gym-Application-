{
  "name": "@gym/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/index.js",
    "start:worker": "node --env-file=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && tsx --env-file=.env src/db/setup-timescale.ts",
    "db:deploy": "prisma migrate deploy && tsx --env-file=.env src/db/setup-timescale.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "src/db/schema.prisma",
    "seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@gym/shared": "*",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.16.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
