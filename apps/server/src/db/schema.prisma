// Primary relational store. Column names are snake_case (@map) and match the
// wire format in packages/shared/src/tables.ts exactly.
//
// Sync columns on every synced model:
//   id             client-generated UUID (never generated server-side for synced rows)
//   updated_at     client wall-clock of last edit — drives Last-Write-Wins
//   deleted_at     tombstone; rows are never hard-deleted
//   server_version per-user monotonically increasing counter (users.sync_version) — drives /sync/pull

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitSystem {
  metric
  imperial
}

enum SetType {
  warmup
  working
  drop
  failure
}

/// Mirrors PR_KINDS in packages/shared/src/pr.ts
enum PRKind {
  e1rm
  max_weight
  max_volume
  max_reps
  min_assist
  max_duration
  max_distance
  best_pace
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String     @map("password_hash")
  displayName   String?    @map("display_name")
  unitSystem    UnitSystem @default(metric) @map("unit_system")
  preferences   Json       @default("{}")
  /// Incremented once per /sync/push. Locks the user row, serialising a user's pushes.
  syncVersion   Int        @default(0) @map("sync_version")
  serverVersion Int        @default(0) @map("server_version")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  exercises       ExerciseDefinition[]
  templates       WorkoutTemplate[]
  sessions        WorkoutSession[]
  sessionExercises SessionExercise[]
  sets            WorkoutSet[]
  personalRecords PersonalRecord[]
  telemetry       TelemetryPoint[]
  foods           Food[]
  savedMeals      SavedMeal[]
  recipes         Recipe[]
  recipeBatches   RecipeBatch[]
  foodLogEntries  FoodLogEntry[]
  bodyMetrics     BodyMetric[]

  @@map("users")
}

model ExerciseDefinition {
  id            String    @id @db.Uuid
  /// null = canonical exercise (seeded from DEFAULT_EXERCISES)
  userId        String?   @map("user_id") @db.Uuid
  name          String
  primaryMuscle String    @map("primary_muscle")
  equipment     String
  category      String
  /// Custom exercises only: hidden from pickers, kept in history
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  /// weight_reps | reps_only | weighted_bodyweight | assisted_bodyweight | duration | distance_duration
  trackingType  String    @default("weight_reps") @map("tracking_type")
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user             User?             @relation(fields: [userId], references: [id])
  sessionExercises SessionExercise[]
  personalRecords  PersonalRecord[]

  @@index([userId, serverVersion])
  @@map("exercise_definitions")
}

model WorkoutTemplate {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  title             String
  notes             String?
  folder            String?
  planDayId         String?   @map("plan_day_id")
  /// [{ exercise_id, order_index, target_sets, target_reps, rest_seconds, target_weight_kg, rep_min, rep_max, sets }]
  /// synced as one LWW document
  templateExercises Json      @default("[]") @map("template_exercises")
  serverVersion     Int       @default(0) @map("server_version")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id])
  sessions WorkoutSession[]

  @@index([userId, serverVersion])
  @@map("workout_templates")
}

model WorkoutSession {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  templateId    String?   @map("template_id") @db.Uuid
  planDayId     String?   @map("plan_day_id")
  title         String?
  startTime     DateTime  @map("start_time") @db.Timestamptz(3)
  endTime       DateTime? @map("end_time") @db.Timestamptz(3)
  notes         String?
  rpe           Float?
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user      User                 @relation(fields: [userId], references: [id])
  template  WorkoutTemplate?     @relation(fields: [templateId], references: [id])
  exercises SessionExercise[]
  stats     WorkoutSessionStats?
  telemetry TelemetryPoint[]

  @@index([userId, serverVersion])
  @@index([userId, startTime(sort: Desc)])
  @@map("workout_sessions")
}

model SessionExercise {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  exerciseId    String    @map("exercise_id") @db.Uuid
  orderIndex    Int       @map("order_index")
  notes         String?
  restSeconds   Int?      @map("rest_seconds")
  /// Superset / circuit group (neighbours with the same value)
  supersetGroup String?   @map("superset_group")
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user     User               @relation(fields: [userId], references: [id])
  session  WorkoutSession     @relation(fields: [sessionId], references: [id])
  exercise ExerciseDefinition @relation(fields: [exerciseId], references: [id])
  sets     WorkoutSet[]

  @@index([userId, serverVersion])
  @@index([sessionId, orderIndex])
  @@index([userId, exerciseId])
  @@map("session_exercises")
}

/// Named WorkoutSet to avoid shadowing the JS global `Set`.
model WorkoutSet {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionExerciseId String    @map("session_exercise_id") @db.Uuid
  orderIndex        Int       @map("order_index")
  setType           SetType   @default(working) @map("set_type")
  weightKg          Float?    @map("weight_kg")
  reps              Int?
  rpe               Float?
  isCompleted       Boolean   @default(false) @map("is_completed")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  durationS         Int?      @map("duration_s")
  distanceM         Float?    @map("distance_m")
  notes             String?
  serverVersion     Int       @default(0) @map("server_version")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User              @relation(fields: [userId], references: [id])
  sessionExercise SessionExercise   @relation(fields: [sessionExerciseId], references: [id])
  personalRecords PersonalRecord[]

  @@index([userId, serverVersion])
  @@index([sessionExerciseId, orderIndex])
  @@map("sets")
}

/// Server-computed (BullMQ analytics worker). Not part of the sync protocol.
model PersonalRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  kind       PRKind
  value      Float
  setId      String   @map("set_id") @db.Uuid
  achievedAt DateTime @map("achieved_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User               @relation(fields: [userId], references: [id])
  exercise ExerciseDefinition @relation(fields: [exerciseId], references: [id])
  set      WorkoutSet         @relation(fields: [setId], references: [id])

  @@unique([userId, exerciseId, kind])
  @@map("personal_records")
}

/// Server-computed per-session aggregates (BullMQ analytics worker).
model WorkoutSessionStats {
  sessionId     String   @id @map("session_id") @db.Uuid
  totalVolumeKg Float    @map("total_volume_kg")
  totalSets     Int      @map("total_sets")
  totalReps     Int      @map("total_reps")
  durationS     Int?     @map("duration_s")
  computedAt    DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  session WorkoutSession @relation(fields: [sessionId], references: [id])

  @@map("workout_session_stats")
}

/// High-frequency GPS / heart-rate samples. Converted to a TimescaleDB hypertable
/// partitioned on recorded_at by src/db/setup-timescale.ts (run after every migrate).
/// The primary key must include the time column for hypertables.
model TelemetryPoint {
  sessionId  String   @map("session_id") @db.Uuid
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  userId     String   @map("user_id") @db.Uuid
  lat        Float?
  lng        Float?
  altitudeM  Float?   @map("altitude_m")
  heartRate  Int?     @map("heart_rate")

  user    User           @relation(fields: [userId], references: [id])
  session WorkoutSession @relation(fields: [sessionId], references: [id])

  @@id([sessionId, recordedAt])
  @@index([userId, recordedAt(sort: Desc)])
  @@map("telemetry_points")
}

// ───────────── Food tracking (ROADMAP 2.15). Text-only until Phase 8 (no migration run). ─────────────

/// Nutrients per 100 g (or 100 ml).
model Food {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  brand         String?
  barcode       String?
  source        String
  basis         String    @default("g")
  kcal          Float
  proteinG      Float?    @map("protein_g")
  carbsG        Float?    @map("carbs_g")
  fatG          Float?    @map("fat_g")
  fibreG        Float?    @map("fibre_g")
  sugarsG       Float?    @map("sugars_g")
  satFatG       Float?    @map("sat_fat_g")
  saltG         Float?    @map("salt_g")
  servings      Json      @default("[]")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, serverVersion])
  @@index([userId, barcode])
  @@map("foods")
}

model SavedMeal {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  items         Json      @default("[]")
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, serverVersion])
  @@map("saved_meals")
}

model Recipe {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  ingredients   Json      @default("[]")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id])
  batches RecipeBatch[]

  @@index([userId, serverVersion])
  @@map("recipes")
}

/// Nutrients per 100 g of the cooked dish.
model RecipeBatch {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  recipeId      String    @map("recipe_id") @db.Uuid
  cookedWeightG Float     @map("cooked_weight_g")
  kcal          Float
  proteinG      Float?    @map("protein_g")
  carbsG        Float?    @map("carbs_g")
  fatG          Float?    @map("fat_g")
  fibreG        Float?    @map("fibre_g")
  sugarsG       Float?    @map("sugars_g")
  satFatG       Float?    @map("sat_fat_g")
  saltG         Float?    @map("salt_g")
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id])
  recipe Recipe @relation(fields: [recipeId], references: [id])

  @@index([userId, serverVersion])
  @@map("recipe_batches")
}

/// Absolute nutrient snapshot of what was eaten.
model FoodLogEntry {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  localDate     String    @map("local_date")
  meal          String
  loggedAt      DateTime  @map("logged_at") @db.Timestamptz(3)
  kind          String
  foodId        String?   @map("food_id") @db.Uuid
  builtinFoodId String?   @map("builtin_food_id")
  recipeId      String?   @map("recipe_id") @db.Uuid
  batchId       String?   @map("batch_id") @db.Uuid
  name          String
  servingLabel  String?   @map("serving_label")
  servings      Float?
  grams         Float?
  kcal          Float
  proteinG      Float?    @map("protein_g")
  carbsG        Float?    @map("carbs_g")
  fatG          Float?    @map("fat_g")
  fibreG        Float?    @map("fibre_g")
  sugarsG       Float?    @map("sugars_g")
  satFatG       Float?    @map("sat_fat_g")
  saltG         Float?    @map("salt_g")
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, serverVersion])
  @@index([userId, localDate])
  @@map("food_log_entries")
}

model BodyMetric {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  localDate     String    @map("local_date")
  measuredAt    DateTime  @map("measured_at") @db.Timestamptz(3)
  metric        String
  value         Float
  serverVersion Int       @default(0) @map("server_version")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, serverVersion])
  @@map("body_metrics")
}
